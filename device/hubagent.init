#!/bin/sh /etc/rc.common
# procd service: starts the MQTT bridge and respawns it if it ever dies
START=96
USE_PROCD=1
start_service() {
	procd_open_instance
	procd_set_param command /usr/bin/hubagent
	procd_set_param respawn 3600 5 0
	procd_close_instance
}
stop_service() {
	killall mosquitto_sub 2>/dev/null
}
